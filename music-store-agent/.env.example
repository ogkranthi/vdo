# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override (default: anthropic:claude-sonnet-4-5)
# SUPPORT_AGENT_MODEL=anthropic:claude-sonnet-4-5

# --- LangSmith (tracing, Studio, evals) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=melody-records-support

# --- Data ---
