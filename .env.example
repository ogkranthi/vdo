# Get your key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
# TEXT_MODEL=gemini-2.5-flash
# IMAGE_MODEL=imagen-4.0-generate-001
# IMAGE_FALLBACK_MODEL=gemini-3.1-flash-image
# ARTICLES_DIR=articles

# Optional: use an existing Chromium binary instead of letting Remotion
# download its own headless shell (useful in sandboxed/CI environments)
# REMOTION_BROWSER_EXECUTABLE=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell
